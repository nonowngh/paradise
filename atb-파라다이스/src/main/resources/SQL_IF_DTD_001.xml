<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.InterfaceInfoMapper">

    <!-- 컬렉션 resultMap -->
    <resultMap id="InterfaceInfoMap" type="mb.fw.paradise.api.model.InterfaceInfo">
        <id property="interfaceId" column="interface_id"/>
        <result property="cronExpression" column="cron_expression"/>
        <result property="patternType" column="pattern_type"/>
        <result property="sndSystemCode" column="send_system_code"/>
        <result property="rcvSystemCode" column="recv_system_code"/>

        <!-- 속성 목록 -->
        <collection property="propertyList" ofType="mb.fw.paradise.api.model.PatternProperty">
            <result property="propertyName" column="property_name"/>
            <result property="propertyValue" column="property_value"/>
        </collection>

        <!-- 쿼리 목록 -->
        <collection property="sqlQueryList" ofType="mb.fw.paradise.api.model.SqlQuery">
            <result property="sqlId" column="sql_id"/>
            <result property="query" column="query"/>
        </collection>
    </resultMap>

    <!-- SELECT -->
    <select id="selectInterfaceWithDetails" parameterType="string" resultMap="InterfaceInfoMap">
        SELECT 
            i.interface_id,
            i.cron_expression,
            i.pattern_type,
            i.send_system_code,
            i.recv_system_code,
            d.property_name,
            d.property_value,
            q.sql_id,
            q.query
        FROM interface.tb_interface_info i
        LEFT JOIN interface.tb_interface_detail d
            ON i.interface_id = d.interface_id
        LEFT JOIN interface.tb_interface_query q
            ON i.interface_id = q.interface_id
        WHERE i.interface_id = #{interfaceId}
    </select>

</mapper>