server:
  port: 29011

web:
  client:
    interface-info-url: http://127.0.0.1:8090
    gateway-url: http://127.0.0.1:28000

adaptor:
  type: RFC
  module-config:
    system-code: SAP
    interface-list:
      - IF_UAS_CB_TRS_002

sap:
  connection:
    destination-name: indigoJco
    ashost: 127.0.0.1
    r3name: 00
    msserv: 9090
    client: indigo
    user: indigo
    passwd: meta1234!
    lang: ko
    group: indigo
    trace: 00
    sysnr: 01    

spring:
  main:
    web-application-type: reactive
    allow-bean-definition-overriding: true
  autoconfigure:
    exclude:
      - org.springframework.boot.autoconfigure.mustache.MustacheAutoConfiguration
      - org.springframework.boot.autoconfigure.quartz.QuartzAutoConfiguration
      - org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration
      